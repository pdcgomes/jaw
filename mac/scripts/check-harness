#!/bin/sh
# Fails when the harness names jawd's client: it draws from fixtures and asks jawd for nothing, so
# nothing in it may make a Jawd, or JawKit's Client, which opens jawd's socket itself. Its other rules
# come with the harness's later phases (the Mac harness's design, "The checks").
cd "$(dirname "$0")/.."
if [ ! -d JawHarness/Sources ]; then
    echo "check-harness: there's no JawHarness/Sources to check" >&2
    exit 1
fi
found=$(grep -rnw 'Jawd' JawHarness/Sources)
if [ -n "$found" ]; then
    echo "$found"
    echo "check-harness: the harness draws from fixtures and never names Jawd" >&2
    exit 1
fi
found=$(grep -rnw 'Client' JawHarness/Sources)
if [ -n "$found" ]; then
    echo "$found"
    echo "check-harness: the harness draws from fixtures and never names JawKit's Client, which opens jawd's socket itself" >&2
    exit 1
fi
