#!/bin/sh
# Fails when the harness names jawd's client, or when the app target defines a view or a view
# controller of its own. The harness draws from fixtures and asks jawd for nothing, so nothing in it
# may make a Jawd, or JawKit's Client, which opens jawd's socket itself; and everything the app
# draws lives in JawUI, made from values, so no type in JawApp may be a view or a view controller
# (a window controller isn't one). Its third rule comes with the harness's third phase (the Mac
# harness's design, "The checks").
cd "$(dirname "$0")/.."
for folder in JawHarness/Sources JawApp/Sources; do
    if [ ! -d "$folder" ]; then
        echo "check-harness: there's no $folder to check" >&2
        exit 1
    fi
done
found=$(grep -rnw 'Jawd' JawHarness/Sources)
if [ -n "$found" ]; then
    echo "$found"
    echo "check-harness: the harness draws from fixtures and never names Jawd" >&2
    exit 1
fi
found=$(grep -rnw 'Client' JawHarness/Sources)
if [ -n "$found" ]; then
    echo "$found"
    echo "check-harness: the harness draws from fixtures and never names JawKit's Client, which opens jawd's socket itself" >&2
    exit 1
fi
# A class, struct, enum or extension whose inherited types, on its first line, include a view (any
# type named …View, SwiftUI's Shape, NSBox or one of AppKit's controls), a view controller (any
# …ViewController, NSPageController, NSCollectionViewItem or a hosting controller) or a representable.
# Comment lines don't count.
views='[A-Za-z]*View|[A-Za-z]*ViewController|NS[A-Za-z]*(Control|Button|Field|Box|Scroller|Slider|Stepper|Switch|Matrix|Browser|Well|Picker|Indicator|Editor)|NSPageController|NSCollectionViewItem|NSHostingController|NSView(Controller)?Representable|(Insettable)?Shape'
found=$(grep -rnE "(^|[^A-Za-z0-9_])(class|struct|enum|extension)[[:space:]]+[A-Za-z_][A-Za-z0-9_.]*(<[^>]*>)?[[:space:]]*:([^{]*[^A-Za-z0-9_.])?((SwiftUI|AppKit)\.)?($views)([^A-Za-z0-9_]|$)" \
    JawApp/Sources | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//')
if [ -n "$found" ]; then
    echo "$found"
    echo "check-harness: the app target draws nothing of its own: a view or a view controller belongs in JawUI, where the harness can draw it from values" >&2
    exit 1
fi
