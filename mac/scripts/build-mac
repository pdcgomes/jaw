#!/bin/sh
# Builds and tests jaw for the Mac on the build Mac, so this Mac stays free for other work (the
# owner's rule, as Redlamp's scripts/build-mac.py keeps it). The checkout is copied as it is, new and
# changed files included, to ~/src/build-mac/jaw/<checkout> there, and the job runs there:
#
#   mac/scripts/build-mac test <Scheme> [xcodebuild options]   # JawKit, JawThemes, JawUITests
#   mac/scripts/build-mac build [<Scheme>]                       # jaw by default
#   mac/scripts/build-mac snapshot <out.png> [app options]       # Jaw.app --demo drawn into a picture
#   mac/scripts/build-mac shot <scene> <out.png> [harness options]  # one harness scene drawn into a picture
#   mac/scripts/build-mac sweep [harness options]                   # every harness scene in each variant, into mac/build/review
#   mac/scripts/build-mac harness [scene] [harness options]         # the harness, built there and opened here
#   mac/scripts/build-mac references                             # the snapshot tests' pictures, back here
#   mac/scripts/build-mac release <folder>                       # Jaw.app in Release, signed ad hoc, back here
#
# The build Mac has no Rust or Go, so jawd is built here (cargo build -p jawd) and its binary goes
# with the checkout, for the live tests and --demo. When the build Mac doesn't answer, the job runs here.
set -eu
here="$(cd "$(dirname "$0")/../.." && pwd)"
host="${JAW_BUILD_MAC:-build-mac}"
remote="src/build-mac/jaw/$(basename "$here")"
what="${1:-}"; [ $# -gt 0 ] && shift
harness=build/DerivedData/Build/Products/Debug/JawHarness.app/Contents/MacOS/JawHarness

ssh_() { ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "$@"; }

if ! ssh_ true 2>/dev/null; then
    echo "==> $host doesn't answer; running here" >&2
    case "$what" in
        test) exec "$here/mac/scripts/check" test "$@" ;;
        build) exec "$here/mac/scripts/check" build "$@" ;;
        shot)
            scene="$1"; out="$2"; shift 2
            "$here/mac/scripts/check" build JawHarness
            "$here/mac/$harness" --scene "$scene" --snapshot "$out" "$@"
            echo "==> $out"
            exit 0
            ;;
        sweep)
            "$here/mac/scripts/check" build JawHarness
            "$here/mac/$harness" --sweep "$here/mac/build/review" "$@"
            "$here/mac/scripts/review-data"
            exit 0
            ;;
        harness)
            "$here/mac/scripts/check" build JawHarness
            if [ $# -gt 0 ]; then scene="$1"; shift; set -- --scene "$scene" "$@"; fi
            exec open -n "$here/mac/build/DerivedData/Build/Products/Debug/JawHarness.app" --args "$@"
            ;;
        *) echo "$what needs $host" >&2; exit 1 ;;
    esac
fi

echo "==> copying $(basename "$here") to $host:~/$remote" >&2
ssh_ "mkdir -p ~/$remote"
rsync -a $([ "$what" = references ] || echo --delete) \
    --exclude .git --exclude '/target/*' --include '/target/debug/jawd' --exclude 'build/' --exclude '*.xcodeproj' \
    --exclude '*.xcworkspace' --exclude Derived --exclude .DS_Store --exclude __pycache__ --exclude /.work --exclude /.atelier \
    --exclude '/marketing/*.mp4' --exclude '/marketing/*.gif' \
    -e "ssh -o BatchMode=yes" "$here/" "$host:$remote/"
if [ -x "$here/target/debug/jawd" ]; then
    ssh_ "mkdir -p ~/$remote/target/debug"
    rsync -a -e "ssh -o BatchMode=yes" "$here/target/debug/jawd" "$host:$remote/target/debug/jawd"
fi

run() { ssh_ "cd ~/$remote/mac && export PATH=/opt/homebrew/bin:\$PATH && mise trust -q ../mise.toml >/dev/null 2>&1; mise exec -- tuist generate --no-open >/dev/null && caffeinate -i $*"; }

case "$what" in
    test|build)
        scheme="${1:-jaw}"; [ $# -gt 0 ] && shift
        run "scripts/check $what $scheme $*"
        ;;
    snapshot)
        # A demo folder of its own for each run, removed after it: every checkout's runs on the build
        # Mac would otherwise share one, with drafts and a jaw.db that earlier runs and other jawds left.
        out="$1"; shift
        run "scripts/check build jaw || exit 1; home=\$(mktemp -d \"\${TMPDIR:?}/jaw-snap.XXXXXX\") || exit 1; build/DerivedData/Build/Products/Debug/Jaw.app/Contents/MacOS/Jaw --demo --home \"\$home\" --snapshot build/snapshot.png $* > build/snapshot.log 2>&1; rm -rf \"\$home\"; tail -12 build/snapshot.log"
        scp -q -o BatchMode=yes "$host:$remote/mac/build/snapshot.png" "$out" && echo "==> $out"
        ;;
    shot)
        scene="$1"; out="$2"; shift 2
        run "scripts/check build JawHarness && $harness --scene $scene --snapshot build/shot.png $*"
        scp -q -o BatchMode=yes "$host:$remote/mac/build/shot.png" "$out" && echo "==> $out"
        ;;
    sweep)
        run "scripts/check build JawHarness && caffeinate -i $harness --sweep build/review $*"
        rm -rf "$here/mac/build/.review.incoming"
        mkdir -p "$here/mac/build/.review.incoming"
        rsync -a -e "ssh -o BatchMode=yes" "$host:$remote/mac/build/review/" "$here/mac/build/.review.incoming/"
        "$here/mac/scripts/take-sweep" "$here/mac/build/.review.incoming" "$here/mac/build/review"
        "$here/mac/scripts/review-data"
        echo "==> $here/mac/build/review"
        ;;
    harness)
        run "scripts/check build JawHarness"
        mkdir -p "$here/mac/build/harness"
        rsync -a --delete -e "ssh -o BatchMode=yes" "$host:$remote/mac/build/DerivedData/Build/Products/Debug/JawHarness.app/" "$here/mac/build/harness/JawHarness.app/"
        if [ $# -gt 0 ]; then scene="$1"; shift; set -- --scene "$scene" "$@"; fi
        open -n "$here/mac/build/harness/JawHarness.app" --args "$@"
        ;;
    release)
        # A failed build stops here, so the app copied back is never an earlier build's.
        out="$1"
        # Ad hoc, with the hardened runtime off: under it dyld refuses ad hoc frameworks ("different Team IDs").
        run "scripts/check build jaw -configuration Release CODE_SIGN_IDENTITY=- ENABLE_HARDENED_RUNTIME=NO"
        mkdir -p "$out"
        rsync -a --delete -e "ssh -o BatchMode=yes" "$host:$remote/mac/build/DerivedData/Build/Products/Release/Jaw.app/" "$out/Jaw.app/"
        ;;
    references)
        rsync -a -e "ssh -o BatchMode=yes" "$host:$remote/mac/Tests/JawUITests/References/" "$here/mac/Tests/JawUITests/References/"
        ;;
    *)
        echo "usage: mac/scripts/build-mac test|build|snapshot|shot|sweep|harness|references" >&2
        exit 2
        ;;
esac
